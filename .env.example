# ───────────────────────────────────────────────────────────────────────────
# OmniMemory API — Exemplo de Variáveis de Ambiente
# ───────────────────────────────────────────────────────────────────────────
# Copie este arquivo para .env e preencha com seus dados reais.

# ── Aplicação
ENVIRONMENT=development
LOG_LEVEL=INFO
API_VERSION=2.0.0

# ── Segurança (OBRIGATÓRIOS)
# Use: openssl rand -hex 32
SECRET_KEY=sua_chave_secreta_aqui
# Senha para o usuário 'admin' no Dashboard
ADMIN_PASSWORD=admin123
# Chave para operações críticas (rotação de keys, etc) via Admin API
SUPER_ADMIN_KEY=super_admin_secret_key_123

# Chave Fernet para criptografia de dados em repouso (opcional)
ENCRYPTION_KEY=

# ── Banco de Dados
# Se estiver usando Docker, o hostname deve ser o nome do serviço (ex: postgres)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/omnimemory

# ── Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── CORS ───────────────────────────────────────────────────────────────────
# Obrigatório usar formato de lista JSON: ["http://localhost:3000"]
ALLOWED_ORIGINS=["*"]

# ── Rate Limiting
GLOBAL_RATE_LIMIT_RPM=200
ADMIN_RATE_LIMIT_RPM=10

# ── JWT
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Modelos de IA (Obrigatório se ENABLE_EMBEDDINGS=true)
GEMINI_API_KEY=
GROQ_API_KEY=

# ── Observabilidade (Opcional)
SENTRY_DSN=

# ── Feature Flags
ENABLE_EMBEDDINGS=true
ENABLE_AUDIO=true
ENABLE_WEBHOOKS=true
